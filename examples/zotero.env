# Settings for zotero-local-mcp: librarian, researcher and weekly alerts.
# Location: ~/.config/opencode/zotero.env (OpenCode and launchd point here with ZOTERO_MCP_ENV).
ZOTERO_VAULT=/Users/you/Notes
ZOTERO_VOCAB=/Users/you/Notes/Systems/Zotero tags.md
# Required for open-access PDFs (Unpaywall). Also sent to Crossref, OpenAlex and NCBI for polite use.
ZOTERO_CONTACT_EMAIL=
# Optional: an NCBI key raises PubMed limits from 3 to 10 requests per second.
NCBI_API_KEY=
# Optional
OPENALEX_API_KEY=
